{
  "meta": {
    "name": "jvm",
    "version": "1.0.0",
    "schema_version": 1
  },
  "filesystem": {
    "allow": [
      "$CWD",
      "$USERPROFILE/.gradle",
      "$USERPROFILE/.m2"
    ],
    "read_only": [
      "$JAVA_HOME"
    ],
    "deny": [
      "$HOME/.ssh",
      "$HOME/.aws"
    ]
  },
  "network": {
    "block_net": false,
    "profile": "developer",
    "allow_domain": [
      "repo.maven.apache.org",
      "repo1.maven.org",
      "plugins.gradle.org",
      "services.gradle.org",
      "downloads.gradle.org"
    ]
  },
  "limits": {
    "workloadTimeoutSecs": 7200
  }
}
